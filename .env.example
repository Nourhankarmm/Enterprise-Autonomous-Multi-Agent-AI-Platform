# Use a random alphanumeric value, 32+ characters, not a real company credential.
POSTGRES_PASSWORD=

# Optional live goal planner. Keep real credentials out of Git.
PLANNER_PROVIDER=demo
OPENAI_MODEL=
OPENAI_API_KEY=

# Optional Gemini free-tier planner: PLANNER_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Optional operator-provided USD estimate rates; no real provider prices are assumed.
# See docs/PHASE_5_REVIEW.md. Empty means live-model costs remain unavailable.
MODEL_PRICING_JSON=

# Optional identity integration; keep local for the original synthetic demo.
AUTH_MODE=local
# For a local Keycloak demo, use scripts/run_identity_demo.py (hidden password prompts).
# Real organization configuration must use exact HTTPS URLs and a trusted client secret file.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_CLIENT_SECRET_FILE=
OIDC_REQUIRED_ACR=
