# Use a random alphanumeric value, 32+ characters, not a real company credential.
POSTGRES_PASSWORD=

# Optional live goal planner. Keep real credentials out of Git.
PLANNER_PROVIDER=demo
OPENAI_MODEL=
OPENAI_API_KEY=

# Optional Gemini free-tier planner: PLANNER_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Optional operator-provided USD estimate rates; no real provider prices are assumed.
# See docs/PHASE_5_REVIEW.md. Empty means live-model costs remain unavailable.
MODEL_PRICING_JSON=
